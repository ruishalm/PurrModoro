{
  "name": "purrmodoro",
  "version": "1.0.0",
  "description": "Idle game de gatinho em pixel art com Timer Pomodoro regulável perto do relógio do Windows.",
  "main": "main.js",
  "scripts": {
    "prepare-assets": "python scripts/prepare_assets.py",
    "start": "node scripts/launch.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.ruishalm.purrmodoro",
    "productName": "PurrModoro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/assets/ui/tray_icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "pomodoro",
    "idle-game",
    "desktop-pet",
    "cat",
    "pixel-art",
    "electron"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0"
  }
}

