{
  "name": "purrmodoro",
  "version": "0.2.2",
  "description": "Idle game de gatinho em pixel art com Timer Pomodoro regulável perto do relógio do Windows.",
  "author": "ruishalm",
  "main": "main.js",
  "scripts": {
    "prepare-assets": "python scripts/prepare_assets.py",
    "start": "node scripts/launch.js",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.ruishalm.purrmodoro",
    "productName": "PurrModoro",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "ruishalm",
        "repo": "PurrModoro"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/assets/ui/tray_icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "PurrModoro-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PurrModoro"
    },
    "portable": {
      "artifactName": "PurrModoro-Portable.${ext}"
    }
  },
  "keywords": [
    "pomodoro",
    "idle-game",
    "desktop-pet",
    "cat",
    "pixel-art",
    "electron"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
